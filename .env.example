# Odiina — local Supabase values printed by `pnpm supabase:start`
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Same-origin application URL. The placeholder domain is not claimed or owned.
ODIINA_APP_URL=http://localhost:3000

# Local rate-limit adapter. Replace before any public beta.
ODIINA_RATE_LIMIT_ADAPTER=memory

# Feature flags — disabled in vertical slice 1.
ODIINA_FEATURE_AI=false
ODIINA_FEATURE_UPLOADS=false
ODIINA_FEATURE_IMAGE_UPLOADS=false
ODIINA_FEATURE_VIDEO_UPLOADS=false
ODIINA_FEATURE_AUDIO_UPLOADS=false
ODIINA_FEATURE_WORKER=false
ODIINA_FEATURE_SHARING=false
ODIINA_FEATURE_PERIOD_REPORTS=false

# Future server-only variables — inactive. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=
OPENAI_ANALYSIS_MODEL=
