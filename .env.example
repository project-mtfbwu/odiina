# Odiina — local Supabase values printed by `pnpm supabase:start`
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Optional hosted signed-TUS endpoint ending in /upload/resumable/sign.
# Local defaults to the signed endpoint derived from SUPABASE_URL.
ODIINA_STORAGE_TUS_URL=

# Same-origin application URL. The placeholder domain is not claimed or owned.
ODIINA_APP_URL=http://localhost:3000

# Local rate-limit adapter. Replace before any public beta.
ODIINA_RATE_LIMIT_ADAPTER=memory

# Feature flags — private image, voice, video and place capture are implemented.
ODIINA_FEATURE_AI=false
ODIINA_FEATURE_UPLOADS=true
ODIINA_FEATURE_IMAGE_UPLOADS=true
ODIINA_FEATURE_VIDEO_UPLOADS=true
ODIINA_FEATURE_AUDIO_UPLOADS=true
ODIINA_FEATURE_PLACES=true
ODIINA_FEATURE_WORKER=true
ODIINA_FEATURE_SHARING=false
ODIINA_FEATURE_PERIOD_REPORTS=false

# Increment I AI runtime. Every user consent switch still defaults OFF.
# `fake` is deterministic, costs nothing and is refused outside loopback.
# No live provider is approved or configured in this repository.
ODIINA_AI_PROVIDER=disabled
ODIINA_ALLOW_FAKE_AI=false
ODIINA_AI_WORKER_EMAIL=
ODIINA_AI_WORKER_PASSWORD=

# Private media worker. Supply values in the worker process environment.
# The normal worker uses only the publishable key plus this non-human login.
ODIINA_MEDIA_WORKER_EMAIL=
ODIINA_MEDIA_WORKER_PASSWORD=
ODIINA_CLAMAV_HOST=127.0.0.1
ODIINA_CLAMAV_PORT=3310
ODIINA_CLAMAV_TIMEOUT_MS=15000
ODIINA_FFMPEG_PATH=ffmpeg
ODIINA_FFPROBE_PATH=ffprobe

# Never store ODIINA_MEDIA_BOOTSTRAP_SERVICE_ROLE_KEY here or in .env.local.
# Set it for one bootstrap process, then remove it from the shell.
# Never store ODIINA_AI_BOOTSTRAP_SERVICE_ROLE_KEY here either.

# No map/geocoding provider is configured. Place search and nearby discovery
# remain unavailable; manual labels and explicit one-time device location work.

# No OpenAI or other live AI key is configured or required in Increment I.
