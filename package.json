{
  "name": "odiina",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db supabase/tests",
    "test:e2e": "playwright test",
    "test:e2e:authenticated": "corepack pnpm seed:e2e-user && playwright test --project=authenticated-desktop",
    "test:e2e:certify-mobile": "playwright test --project=authenticated-mobile --workers=1",
    "test:a11y": "playwright test --grep @a11y",
    "scan:client": "node scripts/scan-client-output.mjs",
    "configure:local-env": "supabase status -o json | node scripts/configure-local-env.mjs",
    "seed:e2e-user": "node --env-file-if-exists=.env.local scripts/create-local-test-user.mjs",
    "media:scanner": "docker compose -f compose.media.yml up -d",
    "media:scanner:stop": "docker compose -f compose.media.yml down",
    "media:worker:bootstrap": "node scripts/bootstrap-media-worker.mjs",
    "media:worker": "node --env-file-if-exists=.env.local scripts/media-worker.mjs",
    "media:worker:once": "node --env-file-if-exists=.env.local scripts/media-worker.mjs --once",
    "media:worker:container": "docker compose -f compose.media.yml --profile worker up --build media-worker",
    "ai:worker:bootstrap": "node scripts/bootstrap-ai-worker.mjs",
    "ai:worker": "node --env-file-if-exists=.env.local scripts/ai-worker.mjs",
    "ai:worker:once": "node --env-file-if-exists=.env.local scripts/ai-worker.mjs --once",
    "test:scanner": "node scripts/certify-clamav.mjs",
    "test:audio": "docker compose -f compose.media.yml --profile worker run --rm --no-deps media-worker node scripts/certify-audio.mjs",
    "test:video": "docker compose -f compose.media.yml --profile worker run --rm --no-deps media-worker node scripts/certify-video.mjs",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset --local",
    "supabase:stop": "supabase stop",
    "check": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build && corepack pnpm scan:client"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.7",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-aria-components": "1.19.0",
    "react-dom": "19.2.7",
    "sharp": "0.35.3",
    "tus-js-client": "4.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.11",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "29.1.1",
    "postcss": "8.5.12",
    "prettier": "3.9.5",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
